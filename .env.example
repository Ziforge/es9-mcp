# ES-9 MCP Server Configuration

# MIDI port name substrings (auto-detect if empty)
ES9_MIDI_OUTPUT_PORT=ES-9
ES9_MIDI_INPUT_PORT=ES-9

# Audio device name substring (auto-detect if empty)
ES9_AUDIO_DEVICE=ES-9

# Sample rate for CV engine (48000 or 96000)
ES9_SAMPLE_RATE=48000

# Auto-connect on server startup
ES9_AUTO_CONNECT=false
